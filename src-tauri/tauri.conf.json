{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "immichsync",
  "version": "0.2.1",
  "identifier": "com.txuli.immichsync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "immichsync",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/immich-go"],
    "resources": [
      "icons/128x128.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNDc3NjlFQTM4REEzMEQKUldRTm80MmpublpIRzFtR3VIT05Qc1R0cWZNWDRyMTZ0dWJ0d3piTzFJTUNSUk1LTHNZWHU5VWcK",
      "endpoints": [
        "https://github.com/txuli/ImmichSync/releases/latest/download/latest.json"
      ]
    }
  }
}
